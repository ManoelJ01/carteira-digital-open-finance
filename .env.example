# Banco de dados
MYSQL_ROOT_PASSWORD=defina-uma-senha-root
MYSQL_DATABASE=carteira_digital
MYSQL_USER=carteira_user
MYSQL_PASSWORD=defina-uma-senha-do-banco

SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/carteira_digital?useSSL=false&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=carteira_user
SPRING_DATASOURCE_PASSWORD=defina-uma-senha-do-banco

# JWT
JWT_SECRET=troque-esta-chave-por-uma-string-aleatoria-com-pelo-menos-256-bits
JWT_EXPIRATION_MS=86400000

# Pluggy (Sandbox) - https://dashboard.pluggy.ai
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_BASE_URL=https://api.pluggy.ai

# Agendamento da sincronização automática (cron)
SYNC_CRON=0 0 */6 * * *
